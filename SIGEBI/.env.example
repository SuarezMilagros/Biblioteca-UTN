# Copiar este archivo como .env (en esta misma carpeta) y completar los valores. El .env no se sube a git.
DB_NAME=sigebi
DB_USER=sigebi_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Clave secreta de Django. Generala con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# y pegala entre comillas simples.
DJANGO_SECRET_KEY=
# True para desarrollo, False para producción. Con False, Django no muestra los estilos y responde 400 en localhost.
DJANGO_DEBUG=True
# Hosts que atiende Django, separados por coma. Con DJANGO_DEBUG=True puede quedar vacía.
# Con False, poner el dominio real. Para probar en esta PC con False: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=