# Copiar este archivo como .env (en esta misma carpeta) y completar los valores. El .env no se sube a git.
DB_NAME=sigebi
DB_USER=sigebi_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Clave secreta de Django. Generala con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# y pegala entre comillas simples.
DJANGO_SECRET_KEY=
# True para desarrollo, False para producción. Con False, Django no muestra los estilos y responde 400 en localhost.
DJANGO_DEBUG=True
# Hosts que atiende Django, separados por coma. Con DJANGO_DEBUG=True puede quedar vacía.
# Con False, poner el dominio real. Para probar en esta PC con False: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=

# ---------- Correo (D-C6) ----------
# Si EMAIL_HOST queda vacío, el correo no se envía: se muestra en la consola de runserver.
# Ejemplo con Gmail: la cuenta necesita verificación en dos pasos y una "contraseña de aplicación"
# (Cuenta de Google > Seguridad > Contraseñas de aplicaciones). Esa contraseña va SOLO en el .env.
EMAIL_HOST=
# EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remitente que ven las personas. Con Gmail, tiene que ser la misma cuenta de EMAIL_HOST_USER.
# Ejemplo: DEFAULT_FROM_EMAIL=SIGEBI <cuenta-de-la-biblioteca@gmail.com>
DEFAULT_FROM_EMAIL=

# ---------- Material digital (Release 2) ----------
# Carpeta donde se guardan los PDF. No es pública. Si queda vacía, se usa SIGEBI/material_privado.
# En producción, poner una carpeta fuera del proyecto e incluirla en las copias de seguridad.
MATERIAL_DIGITAL_ROOT=
