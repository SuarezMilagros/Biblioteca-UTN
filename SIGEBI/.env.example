# Copiar este archivo como .env (en esta misma carpeta) y completar los valores. El .env no se sube a git.
# En el servidor (Railway) no hay .env: estas variables se cargan en el panel del servicio (ver docs/despliegue-railway.md).

# Base de datos. En Railway alcanza con DATABASE_URL (postgresql://usuario:clave@servidor:puerto/base);
# si está, se ignoran las DB_ de abajo.
# DATABASE_URL=
DB_NAME=sigebi
DB_USER=sigebi_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Clave secreta de Django. Generala con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# y pegala entre comillas simples.
DJANGO_SECRET_KEY=
# True para desarrollo, False para producción. Con False, los estilos se sirven después de
# python manage.py collectstatic, y hay que completar DJANGO_ALLOWED_HOSTS.
DJANGO_DEBUG=True
# Hosts que atiende Django, separados por coma. Con DJANGO_DEBUG=True puede quedar vacía.
# Con False, poner el dominio real. Para probar en esta PC con False: localhost,127.0.0.1
# En Railway la dirección pública del servicio se agrega sola.
DJANGO_ALLOWED_HOSTS=
# True solo en el servidor publicado (Railway): todo por HTTPS y cookies seguras. En esta PC, dejarla vacía.
DJANGO_HTTPS=

# ---------- Correo (D-C6) ----------
# Si EMAIL_HOST queda vacío, el correo no se envía: se muestra en la consola de runserver.
# Ejemplo con Gmail: la cuenta necesita verificación en dos pasos y una "contraseña de aplicación"
# (Cuenta de Google > Seguridad > Contraseñas de aplicaciones). Esa contraseña va SOLO en el .env.
EMAIL_HOST=
# EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remitente que ven las personas. Con Gmail, tiene que ser la misma cuenta de EMAIL_HOST_USER.
# Ejemplo: DEFAULT_FROM_EMAIL=SIGEBI <cuenta-de-la-biblioteca@gmail.com>
DEFAULT_FROM_EMAIL=
# Railway bloquea el SMTP: allá los correos salen por la API de Brevo. Con BREVO_API_KEY se usa Brevo y se
# ignoran las EMAIL_ de arriba. La clave se crea en Brevo > SMTP y API > Claves API; va SOLO en el panel.
BREVO_API_KEY=

# ---------- Material digital (Release 2) ----------
# Carpeta donde se guardan los PDF. No es pública. Si queda vacía, se usa SIGEBI/material_privado.
# En producción, poner una carpeta fuera del proyecto e incluirla en las copias de seguridad.
# En Railway: /data/privado (dentro del volumen, así no se borra al publicar).
MATERIAL_DIGITAL_ROOT=
# Portadas de los libros. Si queda vacía, SIGEBI/media. En Railway: /data/media.
MEDIA_ROOT=

# ---------- Solo en el servidor (Railway), para "python manage.py preparar_sitio" ----------
# Cuenta de administración para entrar la primera vez. Si ya existe, no se modifica.
# SIGEBI_ADMIN_CORREO=
# SIGEBI_ADMIN_CLAVE=
# True para cargar los datos de prueba ficticios.
# SIGEBI_DATOS_DEMO=
